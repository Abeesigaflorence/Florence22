## 8. Business logic — implement exactly

### 8.1 Derived values (`domain/FarmMath.kt`)

```kotlin
fun survivalPct(initial: Double, current: Double) = if (initial > 0) current / initial * 100 else 0.0

fun birdAgeDays(placementDate: String?, today: LocalDate = LocalDate.now(ZoneOffset.UTC)): Int =
    runCatching { ChronoUnit.DAYS.between(LocalDate.parse(placementDate), today).toInt() }
        .getOrDefault(0).coerceAtLeast(0)

fun isLowStock(item: InventoryItem) = item.quantity <= item.reorderLevel

data class FlockMoney(val revenue: Double, val cost: Double) { val profit get() = revenue - cost }

fun flockMoney(flockId: String, sales: List<Sale>, expenses: List<Expense>) = FlockMoney(
    revenue = sales.filter { it.flockId == flockId }.sumOf { it.total },
    cost = expenses.filter { it.flockId == flockId }.sumOf { it.amount })
```

### 8.2 Writes with side effects (must behave like this)

**Log production** — insert the record; **if `mortality > 0`**, also update the flock (`mortalityCount += mortality`, `currentCount = max(0, currentCount − mortality)`).

```kotlin
suspend fun logProduction(record: ProductionRecord, flock: Flock) {
    productionCol().add(record.withAudit()).await()
    val lost = record.mortality
    if (lost > 0) {
        flockCol().document(flock.id).update(
            mapOf("mortalityCount" to (flock.mortalityCount + lost.toInt()),
                  "currentCount" to max(0, flock.currentCount - lost.toInt()))
        ).await()
    }
}
```

**Create flock** — `currentCount = initialCount`, `mortalityCount = 0`, `status = active`.

**Stock movement** — insert the movement and update the item in one transaction:

```kotlin
suspend fun recordMovement(item: InventoryItem, type: String, qty: Double, date: String, note: String) {
    val db = FirebaseFirestore.getInstance()
    db.runTransaction { tx ->
        val ref = db.collection("inventoryItems").document(item.id)
        val fresh = tx.get(ref).toObject(InventoryItem::class.java)!!
        val next = max(0.0, fresh.quantity + if (type == "in") qty else -qty)
        tx.update(ref, "quantity", next)
        tx.set(db.collection("stockMovements").document(),
               StockMovement(itemId = item.id, itemName = fresh.name, type = type,
                             quantity = qty, date = date, note = note).withAudit())
        null
    }.await()
}
```

