### 8.4 Month bucketing (`domain/Finance.kt`)

Window = the **last 6 calendar months including the current one**, oldest first. Short label `"Nov"`, full label `"November 2026"`.

```kotlin
object Finance {
    const val WINDOW = 6

    fun monthKey(iso: String?): String = iso?.take(7) ?: ""

    data class MonthPoint(val key: String, val label: String, val full: String,
                          val revenue: Double, val expenses: Double) {
        val profit get() = revenue - expenses
    }

    fun windowMonths(months: Int = WINDOW, today: YearMonth = YearMonth.now(ZoneOffset.UTC)): List<YearMonth> =
        (months - 1 downTo 0).map { today.minusMonths(it.toLong()) }

    fun monthlySeries(sales: List<Sale>, expenses: List<Expense>, months: Int = WINDOW): List<MonthPoint> {
        val byRev = sales.groupBy { monthKey(it.date) }.mapValues { e -> e.value.sumOf { it.total } }
        val byExp = expenses.groupBy { monthKey(it.date) }.mapValues { e -> e.value.sumOf { it.amount } }
        return windowMonths(months).map { ym ->
            val key = ym.toString() // yyyy-MM
            MonthPoint(
                key = key,
                label = ym.format(DateTimeFormatter.ofPattern("MMM", Locale.UK)),
                full = ym.format(DateTimeFormatter.ofPattern("MMMM yyyy", Locale.UK)),
                revenue = byRev[key] ?: 0.0,
                expenses = byExp[key] ?: 0.0)
        }
    }
}
```

### 8.5 Forecast — linear least squares (the core "smart" feature)

Fit each series separately with `x = 0..n-1`:

```
slope     = Σ(x−x̄)(y−ȳ) / Σ(x−x̄)²      (0 if the denominator is 0)
intercept = ȳ − slope·x̄
SSres     = Σ(y − (intercept + slope·x))²
SStot     = Σ(y − ȳ)²
r²        = SStot > 0 ? max(0, 1 − SSres/SStot) : 0
projection(step) = max(0, intercept + slope·step)
```

- Projected revenue / expenses use their own fits at `step = n + i` (`i = 0..h-1`).
- Projected profit = projected revenue − projected expenses.
- **Confidence = min(r² revenue, r² expenses)**, shown as a whole percentage.
- Dashboard forecast: `h = 1` (next month, labelled with its full month name); card caption "Projected net profit, based on the last 6 months of actual results."
- Direction of the first projected month vs. the last actual month:
  `flat` if `|first.profit − last.profit| < max(20_000, |last.profit| * 0.05)`; else `up` / `down`.
  Chips: Rising (up arrow) / Steady (minus) / Declining (down arrow).

```kotlin
data class Fit(val slope: Double, val intercept: Double, val r2: Double)
fun fit(ys: List<Double>): Fit {
    val n = ys.size
    if (n < 2) return Fit(0.0, ys.firstOrNull() ?: 0.0, 0.0)
    val xs = List(n) { it.toDouble() }
    val xb = xs.average(); val yb = ys.average()
    val den = xs.sumOf { (it - xb) * (it - xb) }
    val slope = if (den == 0.0) 0.0 else xs.zip(ys).sumOf { (x, y) -> (x - xb) * (y - yb) } / den
    val icpt = yb - slope * xb
    val ssRes = xs.zip(ys).sumOf { (x, y) -> val e = y - (icpt + slope * x); e * e }
    val ssTot = ys.sumOf { val d = it - yb; d * d }
    val r2 = if (ssTot > 0) (1 - ssRes / ssTot).coerceAtLeast(0.0) else 0.0
    return Fit(slope, icpt, r2)
}

data class ProjectedMonth(val key: String, val label: String, val full: String,
                          val revenue: Double, val expenses: Double) { val profit get() = revenue - expenses }

data class ForecastReport(
    val projected: List<ProjectedMonth>,       // horizon length
    val confidence: Double,                    // 0..1
    val direction: String,                     // "up" | "down" | "flat"
    val months: Int = Finance.WINDOW
) {
    val next get() = projected.first()
    val projectedProfit get() = next.profit
    val projectedRevenue get() = next.revenue
    val projectedExpenses get() = next.expenses
    val nextLabel get() = projected.firstOrNull()?.let { it.full.substringBefore(" ") } ?: "Next month"
}

fun forecast(series: List<Finance.MonthPoint>, horizon: Int = 1,
             today: YearMonth = YearMonth.now(ZoneOffset.UTC)): ForecastReport {
    val fr = fit(series.map { it.revenue })
    val fe = fit(series.map { it.expenses })
    val n = series.size
    val projected = (0 until horizon).map { i ->
        val ym = today.plusMonths(i + 1L)
        val step = (n + i).toDouble()
        ProjectedMonth(
            key = ym.toString(),
            label = ym.format(DateTimeFormatter.ofPattern("MMM", Locale.UK)),
            full = ym.format(DateTimeFormatter.ofPattern("MMMM yyyy", Locale.UK)),
            revenue = (fr.intercept + fr.slope * step).coerceAtLeast(0.0),
            expenses = (fe.intercept + fe.slope * step).coerceAtLeast(0.0))
    }
    val last = series.lastOrNull()?.profit ?: 0.0
    val first = projected.first().profit
    val delta = first - last
    val direction = when {
        abs(delta) < maxOf(20_000.0, abs(last) * 0.05) -> "flat"
        first > last -> "up"
        else -> "down"
    }
    return ForecastReport(projected, minOf(fr.r2, fe.r2), direction)
}
```

